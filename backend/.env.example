PORT=4000
BACKEND_PUBLIC_BASE_URL=http://localhost:4000
NODE_ENV=development

# Chain / contract
CHAIN_ID=11155111
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-key
CONTRACT_ADDRESS=0xa97a9dA0A4E1214E6784fCA0453A5cC141D0c7dA
MINTER_PRIVATE_KEY=0x

# Optional scheduler defaults
MINT_CAP_PER_DAY=50
MINT_CAP_PER_HOUR=10
DEFAULT_SERIES_ID=1
DEFAULT_EDITION_SIZE=25

# Feature flags (MVP mocks)
ENABLE_MOCK_AI=false
ENABLE_MOCK_IPFS=false
ENABLE_MOCK_PAYMENT=true

# AI provider (for non-mock mode)
AI_PROVIDER=huggingface
AI_API_BASE_URL=https://router.huggingface.co
AI_API_KEY=
AI_GENERATE_PATH=/generate
AI_HF_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
AI_HF_MODEL_PATH_PREFIX=/hf-inference/models
AI_IMAGE_WIDTH=512
AI_IMAGE_HEIGHT=512

# IPFS provider (for non-mock mode)
IPFS_PROVIDER=pinata
IPFS_API_BASE_URL=https://api.pinata.cloud
IPFS_API_KEY=
IPFS_API_SECRET=
IPFS_API_JWT=
IPFS_PIN_JSON_PATH=/pinning/pinJSONToIPFS

# Payment provider (for non-mock mode)
# Supported: mock | generic | vellis | wert | nowpayments
PAYMENT_PROVIDER=nowpayments
# Example for NOWPayments:
PAYMENT_API_BASE_URL=https://api.nowpayments.io
PAYMENT_API_KEY=
PAYMENT_CREATE_SESSION_PATH=/v1/invoice
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SIGNATURE_HEADER=x-payment-signature
ALLOW_INSECURE_WEBHOOKS=false

# Admin dashboard credentials (backend-validated)
ADMIN_EMAIL=admin@trendmint.local
ADMIN_PASSWORD=admin123
# Optional PBKDF2 hash format: pbkdf2$<iterations>$<salt>$<hex>
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_MINUTES=720
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MINUTES=15
ADMIN_LOGIN_BLOCK_MINUTES=15

# Durable local persistence
PERSISTENCE_DRIVER=postgres
ENABLE_FILE_PERSISTENCE=true
STORE_FILE_PATH=./data/store.json

# PostgreSQL (local)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=123456
PG_DATABASE=trendmint
